# Input
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP=m
CONFIG_FOD_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m

# Vibrator / Haptics
CONFIG_SIH_VIBRATOR=m
CONFIG_INPUT_AW86927_HAPTIC=m

# LEDs
CONFIG_LEDS_AWRGB21024=m

# Regulators / GPIO expanders
CONFIG_MI_T1_CHIP=m

# Storage / MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=m

# Debug / Stability
CONFIG_MI_BOOT_TIME=m
CONFIG_MI_BOOT_MONITOR=m

# Hardware info / event reporting
CONFIG_MI_HARDWARE_ID=m
CONFIG_MIEV=m

# Charging
# CONFIG_QTI_BATTERY_CHARGER is not set
CONFIG_XM_POWER_SUPPLY=m
CONFIG_CHARGER_PARTITION=m
CONFIG_MCA_PROTOCOL_PD=m
CONFIG_MCA_PROTOCOL_QC=m
CONFIG_MCA_EXTERNAL_FG=m
CONFIG_MCA_EXTERNAL_CP=m
CONFIG_MCA_EXTERNAL_WIRELESS=m
CONFIG_MCA_EXTERNAL_BOOST=m
CONFIG_MCA_EXTERNAL_CP_SC8541=m
CONFIG_MCA_EXTERNAL_WIRELESS_SC96281=m
CONFIG_MCA_EXTERNAL_LOADSWITCH=m
CONFIG_MCA_QCOM_SUBPMIC=m
CONFIG_MCA_QCOM_ADSP=m
CONFIG_MCA_QCOM_SYSFS=m
CONFIG_MCA_QCOM_SMEM=m
CONFIG_MCA_QCOM_PANEL=m
CONFIG_MCA_UT_TEST=m

# KernelSU / SuSFS
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
CONFIG_OVERLAY_FS=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
